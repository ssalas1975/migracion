{
    "name": "vocento/frontal-client",
    "description": "Vocento Frontal Client",
    "license": "proprietary",
    "type": "library",
    "authors": [
        {
            "name": "David Zapatero",
            "email": "dzapatero@vocento.com",
            "role": "developer"
        },
        {
            "name": "Hector Prats",
            "email": "hprats@vocento.com",
            "role": "backend developer"
        }

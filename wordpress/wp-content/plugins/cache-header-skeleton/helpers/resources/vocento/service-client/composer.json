{
    "name": "vocento/service-client",
    "description": "Vocento Service Client Base",
    "license": "proprietary",
    "type": "library",
    "authors": [
        {
            "name": "Ariel Ferrandini",
            "email": "aferrandini@vocento.com",
            "role": "Software Architect"
        },
        {
            "name": "Antonio J. Cerezo",
            "email": "acerezo@vocento.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Vocento\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vocento\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.1",
        "php-http/httplug": "^2.0",
        "php-http/message": "^1.4",
        "php-http/discovery": "^1.1",
        "vocento/request-id": "^1.1",
        "psr/log": "^1.0",
        "psr/cache": "^1.0",
        "psr/simple-cache": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.0",
        "vocento/php-http-mock-client": "^2.0",
        "php-http/guzzle6-adapter": "^2.0"
    },
    "suggest": {
        "php-http/guzzle6-adapter": "Adds guzzle6 as HTTP Client"
    },
    "config": {
        "bin-dir": "bin"
    }
}

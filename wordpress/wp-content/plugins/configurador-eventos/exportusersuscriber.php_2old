<?php
define( 'WP_USE_THEMES', false );
$parse_uri = explode( 'wp-content', $_SERVER['SCRIPT_FILENAME'] );
require_once( $parse_uri[0] . 'wp-load.php' );
require_once (dirname(__FILE__) . '/Classes/PHPExcel.php');
global $wpdb;

$blogusers = get_users( 'blog_id=3&role=subscriber' );

$objPHPExcel = new PHPExcel(); 

$objPHPExcel->getProperties()
		->setCreator("user")
    		->setLastModifiedBy("user")
		->setTitle("Office 2007 XLSX Test Document")
		->setSubject("Office 2007 XLSX Test Document")
		->setDescription("Test document for Office 2007 XLSX, generated using PHP classes.")
		->setKeywords("office 2007 openxml php")
		->setCategory("Test result file");
// Set the active Excel worksheet to sheet 0
$objPHPExcel->setActiveSheetIndex(0); 
// Initialise the Excel row number
$rowCount = 0; 
// Sheet cells
$cell_definition = array(
        'A' => 'Fecha de Registro',
		'B' => 'Nombre',
        'C' => 'Apellidos',
		'D' => 'Email',
        'E' => 'Como nos ha conocido'
);
// Build headers
foreach( $cell_definition as $column => $value )
	$objPHPExcel->getActiveSheet()->setCellValue( "{$column}1", $value ); 
// Build cells
 /*
foreach ( $blogusers as $user )
{
		$cell = $rowCount + 2; 
		$objPHPExcel->getActiveSheet()->setCellValue('A'.$cell, $user->user_registered);
		$objPHPExcel->getActiveSheet()->setCellValue('B'.$cell, get_user_meta( $user->ID, 'first_name', true ));
		$objPHPExcel->getActiveSheet()->setCellValue('C'.$cell, get_user_meta( $user->ID, 'last_name', true ));
		$objPHPExcel->getActiveSheet()->setCellValue('D'.$cell, $user->user_email);
		$objPHPExcel->getActiveSheet()->setCellValue('E'.$cell, get_user_meta( $user->ID, 'comonosconocio', true )[0]);
		$rowCount++; 
}*/
        

header('Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
header('Content-Disposition: attachment;filename="inscripciones.xlsx"');
header('Cache-Control: max-age=0');
$objWriter = PHPExcel_IOFactory::createWriter($objPHPExcel, 'Excel2007');
$objWriter->save('php://output');
exit;


echo '333333';
return true;
?>